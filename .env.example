# Copy to .env.local for development. Never commit real values.

# PostgreSQL connection string (Neon, Supabase, Vercel Postgres, Railway, local…).
# Leave EMPTY in development to use the built-in PGlite database in ./.data (zero setup).
DATABASE_URL=

# Signs admin login sessions (at least 32 random characters). Recommended in production.
# If unset in production, a key is derived from DATABASE_URL. Generate one with:  openssl rand -hex 32
AUTH_SECRET=

# Your public site address (used for SEO, sitemap and social previews).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin account created on deploy (`npm run db:deploy`), by `npm run db:seed`, and by the local dev database.
# Local dev defaults: admin@sportbootspro.com / admin12345
ADMIN_EMAIL=
ADMIN_PASSWORD=
